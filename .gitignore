# Xcode
#
# gitignore template for Xcode / Swift programs

# User settings & workspace layout
xcuserdata/
*.xcuserdatad
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Build products
DerivedData/
build/
*.moved-aside

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved

# App packaging
*.ipa
*.dmg
*.dSYM.zip
*.dSYM

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Miscellaneous
*.swp
*~
